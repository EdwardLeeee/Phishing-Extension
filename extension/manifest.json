{
  "manifest_version": 3,
  "name": "URL 釣魚檢測器",
  "version": "1.0",
  "description": "將當前網頁的網址傳送至 Flask 伺服器並透過 ChatGPT API 判斷是否為釣魚網站。",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "icons": {
    "48": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}

